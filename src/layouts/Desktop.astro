---
import '../styles/global.css';
import '../styles/os.css';
import content from '../../data/content.json';

interface Props {
  title?: string;
  description?: string;
  initialApp?: string;
}

const {
  title = 'Guru Ankam',
  description = 'Portfolio of Guru Ankam — photography, music, code & creative work, presented as a desktop operating system.',
  initialApp = '',
} = Astro.props;

const site = content.site;
const disciplines = content.disciplines || [];

const apps = [
  { id: 'photos', label: 'Photos', glyph: '📷' },
  { id: 'player', label: 'Player', glyph: '🎵' },
  { id: 'code', label: 'Code', glyph: '💻' },
  { id: 'studio', label: 'Studio', glyph: '🎨' },
  { id: 'about', label: 'About', glyph: '👤' },
  { id: 'mail', label: 'Mail', glyph: '✉️' },
  { id: 'settings', label: 'Settings', glyph: '⚙️' },
];

const classicPages = [
  { href: '/classic/', label: 'home' },
  { href: '/classic/photography', label: 'photography' },
  { href: '/classic/music', label: 'music' },
  { href: '/classic/code', label: 'code' },
  { href: '/classic/creative', label: 'creative' },
  { href: '/classic/about', label: 'about' },
  { href: '/classic/contact', label: 'contact' },
];

const launchMap: Record<string, string> = {
  '/photography': 'photos',
  '/music': 'player',
  '/code': 'code',
  '/creative': 'studio',
};
---

<!doctype html>
<html lang="en" data-chrome="tui" data-wallpaper="aurora">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          if (t === 'light') document.documentElement.classList.remove('dark');
          else document.documentElement.classList.add('dark');

          var os = JSON.parse(localStorage.getItem('portfolio-os') || '{}');
          if (os.chrome) document.documentElement.dataset.chrome = os.chrome;
          if (os.wallpaper) document.documentElement.dataset.wallpaper = os.wallpaper;
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="os-desktop-root" data-initial-app={initialApp}>
    <noscript>
      <div class="os-noscript">
        <p>PortfolioOS needs JavaScript to boot the desktop.</p>
        <p>
          Classic pages work without it:
          <a href="/classic/photography">Photography</a> ·
          <a href="/classic/music">Music</a> ·
          <a href="/classic/code">Code</a> ·
          <a href="/classic/creative">Creative</a> ·
          <a href="/classic/about">About</a> ·
          <a href="/classic/contact">Contact</a>
        </p>
      </div>
    </noscript>

    <div id="os-wallpaper" aria-hidden="true"></div>

    <div class="os-nameplate" aria-hidden="true">
      <strong>{site.name?.toLowerCase().replace(/\s+/g, '') || 'guru'}@portfolio</strong><br />
      PortfolioOS v1.3 · <span id="os-uptime">uptime 0s</span>
    </div>

    <div id="os-icons">
      {apps.map((app) => (
        <button class="os-icon" type="button" data-launch={app.id} aria-label={`Open ${app.label}`}>
          <span class="os-icon-glyph">{app.glyph}</span>
          <span class="os-icon-label">{app.label}</span>
        </button>
      ))}
    </div>

    <div id="os-windows" role="main"></div>

    <!-- App window templates are provided by the page via this slot -->
    <div hidden id="os-templates">
      <slot name="app-templates" />
    </div>

    <aside id="os-startmenu" aria-label="Start menu">
      <div class="os-sm-head">
        <strong>guru@portfolio</strong><br />~/disciplines — select an application
      </div>
      <div class="os-sm-list">
        {disciplines.map((d: any) => {
          return (
            <button class="os-sm-item" type="button" data-launch={launchMap[d.href] || d.href}>
              <span class="os-sm-num">{d.number}</span>
              <span class="os-sm-dot" style={`background: ${d.color};`} />
              <span class="os-sm-txt">
                <span class="os-sm-title">{d.title}</span><br />
                <span class="os-sm-tagline">{d.tagline}</span>
              </span>
            </button>
          );
        })}
        <button class="os-sm-item" type="button" data-launch="settings">
          <span class="os-sm-num">⚙</span>
          <span class="os-sm-dot" style="background: var(--accent-2);" />
          <span class="os-sm-txt">
            <span class="os-sm-title">Settings</span><br />
            <span class="os-sm-tagline">Skins, wallpapers &amp; system</span>
          </span>
        </button>
      </div>
      <div class="os-sm-foot">
        <span class="os-sm-foot-label">$ ls /classic — traditional single pages</span>
        {classicPages.map((p) => (
          <a class="os-sm-foot-link" href={p.href}>{p.label}</a>
        ))}
      </div>
    </aside>

    <footer id="os-taskbar">
      <button class="os-tb-start" id="os-start-btn" aria-expanded="false" aria-controls="os-startmenu">
        <span class="os-tb-start-glyph">⊞</span>
        <span>start</span>
      </button>
      <div class="os-tb-apps" id="os-tb-apps"></div>
      <div class="os-tb-right">
        <button class="os-tb-tray-btn" id="os-theme-btn" aria-label="Toggle theme" title="Toggle theme (t)">☾</button>
        <span class="metronome-dot" aria-hidden="true" title="72 BPM"></span>
        <div class="os-tb-clock" id="os-clock">
          <span class="os-tb-time">--:--</span>
          <span class="os-tb-date">---</span>
        </div>
      </div>
    </footer>

    <script src="/os/window-manager.js" defer></script>
  </body>
</html>

<style is:global>
  html.os-desktop-root,
  html:has(body.os-desktop-root) { height: 100%; }
  body.os-desktop-root {
    height: 100vh;
    margin: 0;
  }
</style>
