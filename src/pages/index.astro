---
import Desktop from '../layouts/Desktop.astro';
import content from '../../data/content.json';

const site = content.site;
const about = content.pages.about;
const disciplines = content.disciplines || [];

const apps = [
  { id: 'photos', label: 'Photos', glyph: '📷', href: '/photography', interim: true },
  { id: 'player', label: 'Player', glyph: '🎵', href: '/music', interim: true },
  { id: 'code', label: 'Code', glyph: '💻', href: '/code', interim: true },
  { id: 'studio', label: 'Studio', glyph: '🎨', href: '/creative', interim: true },
  { id: 'about', label: 'About', glyph: '👤', launch: true },
  { id: 'mail', label: 'Mail', glyph: '✉️', launch: true },
  { id: 'settings', label: 'Settings', glyph: '⚙️', launch: true },
];

const wallpapers = [
  { id: 'aurora', label: 'aurora' },
  { id: 'midnight', label: 'midnight' },
  { id: 'dusk', label: 'dusk' },
  { id: 'ocean', label: 'ocean' },
  { id: 'grid', label: 'blueprint' },
  { id: 'plain', label: 'plain' },
];

const chromeOpts = [
  { id: 'tui', label: 'warm tui' },
  { id: 'win95', label: 'retro 95' },
  { id: 'win11', label: 'frost 11' },
];
---

<Desktop title="Guru Ankam — PortfolioOS">
  <fragment slot="desktop-icons">
    {apps.map((app) => (
      <button
        class="os-icon"
        type="button"
        {...app.launch ? { 'data-launch': app.id } : { 'data-nav': app.href }}
        aria-label={app.launch ? `Open ${app.label}` : `Open ${app.label} (classic view)`}
      >
        <span class="os-icon-glyph">{app.glyph}</span>
        <span class="os-icon-label">{app.label}</span>
      </button>
    ))}
  </fragment>

  <fragment slot="start-menu-items">
    {disciplines.map((d: any) => (
      <button class="os-sm-item" type="button" data-nav={d.href}>
        <span class="os-sm-num">{d.number}</span>
        <span class="os-sm-dot" style={`background: ${d.color};`} />
        <span class="os-sm-txt">
          <span class="os-sm-title">{d.title}</span><br />
          <span class="os-sm-tagline">{d.tagline}</span>
        </span>
        <span class="os-sm-ext" title="Opens classic view until ported">ext</span>
      </button>
    ))}
    <button class="os-sm-item" type="button" data-launch="settings">
      <span class="os-sm-num">⚙</span>
      <span class="os-sm-dot" style="background: var(--accent-2);" />
      <span class="os-sm-txt">
        <span class="os-sm-title">Settings</span><br />
        <span class="os-sm-tagline">Themes, wallpaper & system</span>
      </span>
    </button>
  </fragment>

  <fragment slot="start-menu-foot">
    <a class="os-sm-foot-link" href="/classic/photography">photography</a>
    <a class="os-sm-foot-link" href="/classic/music">music</a>
    <a class="os-sm-foot-link" href="/classic/code">code</a>
    <a class="os-sm-foot-link" href="/classic/creative">creative</a>
    <a class="os-sm-foot-link" href="/classic/about">about</a>
    <a class="os-sm-foot-link" href="/classic/contact">contact</a>
  </fragment>

  <fragment slot="app-templates">
    <!-- Welcome -->
    <template data-app="welcome">
      <div class="os-window" data-app-id="welcome" data-tb-label="Welcome" data-pos="center" style="--w: 460px; --h: 380px;">
        <div class="os-titlebar">
          <span class="os-title-icon">⊞</span>
          <span class="os-title-text">welcome.txt — PortfolioOS</span>
          <span class="os-title-btns">
            <button class="os-btn os-min" aria-label="Minimize">─</button>
            <button class="os-btn os-max" aria-label="Maximize">▢</button>
            <button class="os-btn os-close" aria-label="Close">✕</button>
          </span>
        </div>
        <div class="os-body">
          <div class="os-app-pad">
            <p class="os-prompt-line">$ boot portfolio-os --user guru ...done ✓</p>
            <h1>Welcome to PortfolioOS</h1>
            <p style="margin-top: 8px;">
              This desktop is my portfolio. Everything is an app — drag windows around,
              resize them, run a few at once. Your first visit, so here are the basics:
            </p>
            <div class="os-welcome-keys">
              <div class="os-welcome-key"><span class="os-kbd">click</span> single-click any desktop icon to open its app</div>
              <div class="os-welcome-key"><span class="os-kbd">start</span> the ⊞ start menu lists all disciplines</div>
              <div class="os-welcome-key"><span class="os-kbd">t</span> toggle night session / daylight studio</div>
              <div class="os-welcome-key"><span class="os-kbd">s</span> open Settings — skins &amp; wallpapers live there</div>
            </div>
            <p style="margin-top: 14px; font-size: 12px; color: var(--text-muted);">
              Prefer traditional pages? Every app also has a classic single-page version
              linked in the start menu footer.
            </p>
          </div>
        </div>
        <div class="os-resize" aria-hidden="true"></div>
      </div>
    </template>

    <!-- Settings -->
    <template data-app="settings">
      <div class="os-window" data-app-id="settings" data-tb-label="Settings" data-pos="center" style="--w: 580px; --h: 600px;">
        <div class="os-titlebar">
          <span class="os-title-icon">⚙️</span>
          <span class="os-title-text">control-panel — Settings</span>
          <span class="os-title-btns">
            <button class="os-btn os-min" aria-label="Minimize">─</button>
            <button class="os-btn os-max" aria-label="Maximize">▢</button>
            <button class="os-btn os-close" aria-label="Close">✕</button>
          </span>
        </div>
        <div class="os-body">
          <div class="os-app-pad">
            <p class="os-prompt-line">$ open settings --panel appearance</p>

            <div class="os-set-section">
              <h3 class="os-set-heading">Window skin</h3>
              <div class="os-set-cards">
                {chromeOpts.map((c) => (
                  <button class="os-set-opt pv-{c.id}" type="button" data-set-chrome={c.id}>
                    <span class="os-set-preview"><span class="pv-tb"></span></span>
                    <span class="os-set-opt-label">{c.label}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="os-set-section">
              <h3 class="os-set-heading">Wallpaper</h3>
              <div class="os-swatches">
                {wallpapers.map((w) => (
                  <button class="os-swatch" type="button" data-set-wall={w.id}>
                    <span class={`os-swatch-art sw-${w.id}`}></span>
                    <span class="os-swatch-label">{w.label}</span>
                  </button>
                ))}
              </div>
            </div>

            <div class="os-set-section">
              <h3 class="os-set-heading">Custom wallpaper</h3>
              <div class="os-custom-wall">
                <div class="os-url-row">
                  <input class="os-input os-url-input" type="url" placeholder="https://…/image.jpg" aria-label="Wallpaper image URL" />
                  <button class="os-btn-accent os-url-apply" type="button">apply</button>
                </div>
                <div class="os-drop-zone" role="button" tabindex="0">
                  …or drag &amp; drop an image here / click to browse
                </div>
                <input class="os-file-input" type="file" accept="image/*" hidden />
                <div>
                  <button class="os-btn-danger-ghost os-wall-reset" type="button">reset to preset</button>
                </div>
              </div>
            </div>

            <div class="os-system-foot">
              <div class="os-sys-info">
                PortfolioOS v1.0 · kernel: astro-static<br />
                theme: <span id="os-sys-theme">—</span> · uptime tracked in tray
              </div>
              <a class="os-btn-ghost" href="/admin.html" target="_blank" rel="noopener noreferrer">Admin Panel ↗</a>
            </div>
          </div>
        </div>
        <div class="os-resize" aria-hidden="true"></div>
      </div>
    </template>

    <!-- About (Notepad) -->
    <template data-app="about">
      <div class="os-window" data-app-id="about" data-tb-label="readme.txt" style="--w: 520px; --h: 500px;">
        <div class="os-titlebar">
          <span class="os-title-icon">📄</span>
          <span class="os-title-text">readme.txt — About</span>
          <span class="os-title-btns">
            <button class="os-btn os-min" aria-label="Minimize">─</button>
            <button class="os-btn os-max" aria-label="Maximize">▢</button>
            <button class="os-btn os-close" aria-label="Close">✕</button>
          </span>
        </div>
        <div class="os-body">
          <div class="os-app-pad">
            <p class="os-prompt-line">$ cat ~/readme.txt</p>
            <h1>{about.title}</h1>
            <div style="margin-top: 10px; display: grid; gap: 10px;">
              {about.bio.map((paragraph: string) => (
                <p set:html={paragraph} />
              ))}
            </div>
            <div style="margin-top: 16px; border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; background: var(--bg-card);">
              <h3>Quick Facts</h3>
              <ul style="margin-top: 8px; display: grid; gap: 6px; font-size: 13px;">
                {about.facts.map((fact: any) => (
                  <li class="os-fact-row">
                    <span class="os-fact-dot" style={`background: ${fact.color};`} />
                    <span set:html={fact.text} />
                  </li>
                ))}
              </ul>
            </div>
            <p style="margin-top: 14px; font-size: 11px; color: var(--text-muted);">
              classic view: <a href="/classic/about" style="color: var(--accent-1);">/classic/about</a>
            </p>
          </div>
        </div>
        <div class="os-resize" aria-hidden="true"></div>
      </div>
    </template>

    <!-- Contact (Mail) -->
    <template data-app="mail">
      <div class="os-window" data-app-id="mail" data-tb-label="new-message" style="--w: 480px; --h: 430px;">
        <div class="os-titlebar">
          <span class="os-title-icon">✉️</span>
          <span class="os-title-text">new-message — Contact</span>
          <span class="os-title-btns">
            <button class="os-btn os-min" aria-label="Minimize">─</button>
            <button class="os-btn os-max" aria-label="Maximize">▢</button>
            <button class="os-btn os-close" aria-label="Close">✕</button>
          </span>
        </div>
        <div class="os-body">
          <div class="os-app-pad">
            <p class="os-prompt-line">$ mail --compose guru</p>
            <h1>Let's Connect</h1>
            <p style="margin-top: 6px; margin-bottom: 14px;">
              Whether it's a collaboration, a project idea, or just a hello — I'd love to hear from you.
            </p>
            <div style="display: grid; gap: 8px;">
              <a class="os-mail-link" href={`mailto:${site.email}`}>
                <span class="os-mail-glyph">📧</span>
                <span>
                  <span class="os-mail-name">Email</span><br />
                  <span class="os-mail-sub">{site.email}</span>
                </span>
              </a>
              <a class="os-mail-link" href={site.github} target="_blank" rel="noopener noreferrer">
                <span class="os-mail-glyph">🐙</span>
                <span>
                  <span class="os-mail-name">GitHub</span><br />
                  <span class="os-mail-sub">{site.github.replace('https://', '')}</span>
                </span>
              </a>
              <a class="os-mail-link" href={site.instagram} target="_blank" rel="noopener noreferrer">
                <span class="os-mail-glyph">📸</span>
                <span>
                  <span class="os-mail-name">Instagram</span><br />
                  <span class="os-mail-sub">{site.instagram.replace('https://', '')}</span>
                </span>
              </a>
              <a class="os-mail-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">
                <span class="os-mail-glyph">💼</span>
                <span>
                  <span class="os-mail-name">LinkedIn</span><br />
                  <span class="os-mail-sub">{site.linkedin.replace('https://', '')}</span>
                </span>
              </a>
            </div>
            <p style="margin-top: 14px; font-size: 11px; color: var(--text-muted);">
              classic view: <a href="/classic/contact" style="color: var(--accent-1);">/classic/contact</a>
            </p>
          </div>
        </div>
        <div class="os-resize" aria-hidden="true"></div>
      </div>
    </template>
  </fragment>
</Desktop>
