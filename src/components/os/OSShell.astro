---
import Desktop from '../../layouts/Desktop.astro';
import WelcomeWindow from './WelcomeWindow.astro';
import SettingsWindow from './SettingsWindow.astro';
import AboutWindow from './AboutWindow.astro';
import MailWindow from './MailWindow.astro';
import PhotosApp from './PhotosApp.astro';
import PhotoViewer from './PhotoViewer.astro';
import PlayerApp from './PlayerApp.astro';
import CodeApp from './CodeApp.astro';
import StudioApp from './StudioApp.astro';

interface Props {
  title?: string;
  description?: string;
  initialApp?: string;
}

const { title, description, initialApp = '' } = Astro.props;
---

<Desktop title={title} description={description} initialApp={initialApp}>
  <fragment slot="app-templates">
    <WelcomeWindow />
    <SettingsWindow />
    <AboutWindow />
    <MailWindow />
    <PhotosApp />
    <PhotoViewer />
    <PlayerApp />
    <CodeApp />
    <StudioApp />
  </fragment>
</Desktop>
